# このファイルを terraform.tfvars にコピーして、自分の値に書き換える。
# terraform.tfvars は Git 管理外(.gitignore 済み)。

# 予算超過の通知を受け取るメールアドレス(必須)
budget_email = "you@example.com"

# 以下は必要なときだけ変更する(既定値でよければ消してよい)
# aws_region     = "ap-northeast-1"
# aws_profile    = "taskmgmt"
# instance_type  = "t3.micro"
# volume_size_gb = 20

# 80/443 を許可する接続元。自分のIPだけにするときの例(curl https://checkip.amazonaws.com で調べる)
# allowed_cidrs = ["203.0.113.5/32"]
