#!/bin/bash
# EC2 の初回起動時に1回だけ実行される初期設定。ログ: /var/log/cloud-init-output.log
set -euxo pipefail

# メモリ1GBのサーバーが重くなったときのための swap(1GB)
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=1024
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Docker と Compose プラグイン
dnf install -y docker
systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-x86_64" \
  -o /usr/local/lib/docker/cli-plugins/docker-compose
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

mkdir -p /opt/app
cd /opt/app

# 設定ファイル(Terraform が中身を埋め込む)
cat > docker-compose.yml <<'COMPOSE_EOF'
${compose_yml}
COMPOSE_EOF

cat > Caddyfile <<'CADDY_EOF'
${caddyfile}
CADDY_EOF

# DB パスワードを SSM から取得して .env を作る(このファイル以外には残さない)。
# 起動直後は IAM の権限が反映される前のことがあるので、取れるまで繰り返す(最大5分)。
DB_PASSWORD=""
for i in $(seq 1 30); do
  if DB_PASSWORD="$(aws ssm get-parameter --region ${region} --name '${db_password_id}' \
    --with-decryption --query Parameter.Value --output text 2>/dev/null)"; then
    break
  fi
  echo "waiting for IAM permissions ($i/30)"
  sleep 10
done
if [ -z "$DB_PASSWORD" ]; then
  echo "failed to read the DB password from SSM" >&2
  exit 1
fi

umask 077
cat > .env <<ENV_EOF
APP_HOST=${app_host}
DB_HOST=${db_host}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=$DB_PASSWORD
ENV_EOF

# jar はまだ無いので、caddy だけ起動する。app は scripts/deploy.ps1 が起動する。
# --no-deps: depends_on の app を巻き込まない(jar が無いまま起動すると app.jar がディレクトリとして作られてしまう)
docker compose up -d --no-deps caddy
